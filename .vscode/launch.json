{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🚀 Full Stack (Backend + Frontend)",
      "type": "node",
      "request": "launch",
      "preLaunchTask": "start-fullstack",
      "program": "${workspaceFolder}/src/Whitebird/ClientApp/node_modules/vite/bin/vite.js",
      "args": ["--host"],
      "cwd": "${workspaceFolder}/src/Whitebird/ClientApp",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Local:\\s+(http://localhost:\\d+)",
        "uriFormat": "%s"
      },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "name": "🎨 Frontend Only",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/src/Whitebird/ClientApp/node_modules/vite/bin/vite.js",
      "args": ["--host"],
      "cwd": "${workspaceFolder}/src/Whitebird/ClientApp",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Local:\\s+(http://localhost:\\d+)",
        "uriFormat": "%s"
      },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "name": "🔧 Backend Only (Development)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-backend",
      "program": "${workspaceFolder}/src/Whitebird/bin/Debug/net8.0/Whitebird.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/Whitebird",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      },
      "env": { "ASPNETCORE_ENVIRONMENT": "Development" },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "name": "📦 Backend (No Browser)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-backend",
      "program": "${workspaceFolder}/src/Whitebird/bin/Debug/net8.0/Whitebird.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/Whitebird",
      "stopAtEntry": false,
      "launchBrowser": false,
      "env": { "ASPNETCORE_ENVIRONMENT": "Development" }
    },
    {
      "name": "🏭 Production (Build + Publish + Run)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "publish-fullstack",
      "program": "${workspaceFolder}/publish/Whitebird.dll",
      "args": [],
      "cwd": "${workspaceFolder}/publish",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s"
      },
      "env": { "ASPNETCORE_ENVIRONMENT": "Production" },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ],
  "compounds": []
}